# 至少 8 位；默认仅含 MCP、生成和本人工件权限。显式 scope 使用 | 分隔，* 仅供受控管理员：
# key=tenant:principal[:scope1|scope2],key2=tenant2:principal2
OMNI_OFFICE_API_KEYS=local-dev-key=default:developer
OMNI_OFFICE_HOST=0.0.0.0
OMNI_OFFICE_PORT=8080
OMNI_OFFICE_DATA_ROOT=/data
OMNI_OFFICE_ALLOWED_ORIGINS=http://localhost:3000
OMNI_OFFICE_REQUESTS_PER_MINUTE=120
OMNI_OFFICE_MAX_CONCURRENT_REQUESTS=8
OMNI_OFFICE_REQUEST_TIMEOUT_SECONDS=60
OMNI_OFFICE_SESSION_TTL_MINUTES=480
# 可选：至少 32 位，用于验证 HS256 JWT（claims 必须含 tenant、sub、exp、scope）
# OMNI_OFFICE_JWT_SECRET=replace-with-at-least-32-characters
# OMNI_OFFICE_JWT_ISSUER=https://identity.example.com
# OMNI_OFFICE_JWT_AUDIENCE=omni-office
# 推荐生产模式：OIDC Discovery + RS256 JWKS；三项必须同时配置
# OMNI_OFFICE_OIDC_ISSUER=https://identity.example.com
# OMNI_OFFICE_OIDC_AUDIENCE=omni-office
# OMNI_OFFICE_RESOURCE_IDENTIFIER=https://documents.example.com
# 可选：仓库外绝对路径；启用预注册 Webhook、持久化 Outbox、HMAC 签名和重试
# OMNI_OFFICE_WEBHOOK_CONFIG_PATH=/data/config/webhook-config.json
# 终态记录自动清理；任务保留天数不得小于 Webhook 保留天数
# OMNI_OFFICE_GENERATION_JOB_RETENTION_DAYS=30
# OMNI_OFFICE_WEBHOOK_RETENTION_DAYS=30
# 可选：管理员维护的绝对路径；配置默认任务配额和租户覆盖
# OMNI_OFFICE_QUOTA_CONFIG_PATH=/data/config/quota-config.json

# 可选：启用内部 AI Generation Job；默认调用本机 Ollama /api/chat
# 调用主体还必须显式拥有 ai:generate scope
# OMNI_OFFICE_OLLAMA_MODEL=qwen3.5:2b
# OMNI_OFFICE_OLLAMA_CHAT_ENDPOINT=http://host.docker.internal:11434/api/chat
# OMNI_OFFICE_OLLAMA_TIMEOUT_SECONDS=300
# OMNI_OFFICE_OLLAMA_TEMPERATURE=0.1

# 多实例生产模式；未设置时任务和 Webhook Outbox 使用单实例文件仓储。
# OMNI_OFFICE_DATABASE_URL=jdbc:postgresql://postgres:5432/omni_office
# OMNI_OFFICE_DATABASE_USERNAME=omni_office
# OMNI_OFFICE_DATABASE_PASSWORD=replace-with-a-strong-database-password
# OMNI_OFFICE_DATABASE_POOL_SIZE=10

# S3/MinIO 对象存储；未设置 bucket 时使用租户本地目录。
# OMNI_OFFICE_S3_BUCKET=omni-office
# OMNI_OFFICE_S3_REGION=us-east-1
# OMNI_OFFICE_S3_PREFIX=omni-office
# OMNI_OFFICE_S3_ENDPOINT=https://s3.example.com
# OMNI_OFFICE_S3_ACCESS_KEY=replace-me
# OMNI_OFFICE_S3_SECRET_KEY=replace-me
# OMNI_OFFICE_S3_PATH_STYLE=false
# 工件/Asset/图工件保留期不得短于 Generation Job 保留期；默认同为 30 天
# OMNI_OFFICE_ARTIFACT_RETENTION_HOURS=720
