{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-office.local/schemas/diagram-spec/1.0/schema.json",
  "title": "Omni Office DiagramSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "nodes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": {
      "enum": ["USE_CASE", "FLOW", "ER", "SYSTEM_ER", "CLASS", "COMPONENT", "OVERALL_FUNCTION_LOGIC"]
    },
    "title": { "$ref": "#/$defs/text" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*" },
    "details": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/text" }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "type": {
          "enum": [
            "ACTOR", "USE_CASE", "START", "PROCESS", "DECISION", "PARALLEL_SPLIT", "PARALLEL_JOIN", "END",
            "ENTITY", "RELATIONSHIP", "ATTRIBUTE", "CLASS", "COMPONENT",
            "FUNCTION_SYSTEM", "FUNCTION_MODULE", "FUNCTION_ITEM"
          ]
        },
        "fields": { "$ref": "#/$defs/details" },
        "classAttributes": { "$ref": "#/$defs/details" },
        "classMethods": { "$ref": "#/$defs/details" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/text" },
        "to": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" }
      }
    }
  }
}
