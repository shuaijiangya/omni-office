{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-office.local/schemas/document-template/1.0/schema.json",
  "title": "Omni Office DocumentTemplateSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateId", "version", "name", "dataSchema", "documentTemplate"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "dataSchema": {
      "type": "object",
      "description": "JSON Schema draft 2020-12 object schema; only internal fragment references are allowed."
    },
    "documentTemplate": {
      "type": "object",
      "required": ["schemaVersion", "metadata", "layout", "sections"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "metadata": { "type": "object" },
        "layout": { "type": "object" },
        "sections": { "type": "array" }
      }
    }
  }
}
