{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-office.local/schemas/document-spec/1.0/schema.json",
  "title": "Omni Office DocumentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "layout", "sections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "layout": { "$ref": "#/$defs/layout" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": ".*\\S.*"
    },
    "styleName": {
      "type": "string",
      "enum": [
        "Normal", "Title", "Subtitle", "BodyText", "Caption", "ImageCaption", "CodeBlock",
        "Heading1", "Heading2", "Heading3", "Heading4", "Heading5",
        "Heading6", "Heading7", "Heading8", "Heading9"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/nonBlankText" },
        "author": { "type": "string", "maxLength": 20000 },
        "subject": { "type": "string", "maxLength": 20000 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styleProfile": { "enum": ["DEFAULT", "BUSINESS_BRIEF", "GJB_438C"] },
        "headingNumberingEnabled": { "type": "boolean" },
        "bodyTitleEnabled": { "type": "boolean" },
        "tableOfContentsDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 9 },
        "headerText": { "type": ["string", "null"], "maxLength": 20000 },
        "footerText": { "type": ["string", "null"], "maxLength": 20000 },
        "pageNumberFooterEnabled": { "type": "boolean" },
        "bodyPageNumberStart": { "type": "integer", "minimum": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "$ref": "#/$defs/nonBlankText" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/bulletListBlock" },
        { "$ref": "#/$defs/numberedListBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/diagramBlock" },
        { "$ref": "#/$defs/subsectionBlock" },
        { "$ref": "#/$defs/pageBreakBlock" }
      ]
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/$defs/nonBlankText" },
        "styleName": { "$ref": "#/$defs/styleName" }
      }
    },
    "bulletListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "bulletList" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "styleName": { "$ref": "#/$defs/styleName" }
      }
    },
    "numberedListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "numberedList" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "styleName": { "$ref": "#/$defs/styleName" }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "headers"],
      "properties": {
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "array",
            "items": { "type": "string", "maxLength": 20000 }
          }
        },
        "columnWidths": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "styleName": { "enum": ["TableNormal", "TableHeader", "TableCell"] },
        "caption": { "type": "string", "maxLength": 20000 },
        "captionAutoNumbered": { "type": "boolean" }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "image" },
        "source": { "$ref": "#/$defs/nonBlankText" },
        "alternativeText": { "type": "string", "maxLength": 20000 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "caption": { "type": "string", "maxLength": 20000 }
      },
      "dependentRequired": {
        "width": ["height"],
        "height": ["width"]
      }
    },
    "diagramBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "diagram" },
        "diagramArtifactId": { "$ref": "#/$defs/nonBlankText" },
        "definition": { "$ref": "https://omni-office.local/schemas/diagram-spec/1.0/schema.json" },
        "embedMode": { "enum": ["PREVIEW_IMAGE", "EDITABLE_VISIO"] },
        "caption": { "type": "string", "maxLength": 20000 },
        "maxWidthPoints": { "type": "number", "exclusiveMinimum": 0 },
        "maxHeightPoints": { "type": "number", "exclusiveMinimum": 0 }
      },
      "dependentRequired": {
        "maxWidthPoints": ["maxHeightPoints"],
        "maxHeightPoints": ["maxWidthPoints"]
      },
      "oneOf": [
        { "required": ["diagramArtifactId"], "not": { "required": ["definition"] } },
        { "required": ["definition"], "not": { "required": ["diagramArtifactId"] } }
      ]
    },
    "subsectionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "blocks"],
      "properties": {
        "type": { "const": "subsection" },
        "title": { "$ref": "#/$defs/nonBlankText" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "pageBreakBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "pageBreak" }
      }
    }
  }
}
