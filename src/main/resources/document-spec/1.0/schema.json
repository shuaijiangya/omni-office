{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-office.local/schemas/document-spec/1.0/schema.json",
  "title": "Omni Office DocumentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "layout", "sections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "layout": { "$ref": "#/$defs/layout" },
    "cover": { "$ref": "#/$defs/cover" },
    "revisionHistory": {
      "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/revision" }
    },
    "approvals": {
      "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/approval" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": ".*\\S.*"
    },
    "styleName": {
      "type": "string",
      "enum": [
        "Normal", "Title", "Subtitle", "BodyText", "Caption", "ImageCaption", "CodeBlock",
        "Heading1", "Heading2", "Heading3", "Heading4", "Heading5",
        "Heading6", "Heading7", "Heading8", "Heading9"
      ]
    },
    "fontColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "captionPosition": {
      "enum": ["ABOVE", "BELOW"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/nonBlankText" },
        "author": { "type": "string", "maxLength": 20000 },
        "subject": { "type": "string", "maxLength": 20000 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styleProfile": { "enum": ["DEFAULT", "BUSINESS_BRIEF", "GJB_438C"] },
        "headingNumberingEnabled": { "type": "boolean" },
        "bodyTitleEnabled": {
          "type": "boolean",
          "description": "Whether to prepend the report title when no table of contents is configured. Ignored when tableOfContentsDepth is set so no framework-generated content is inserted before the caller-defined module body."
        },
        "tableOfContentsDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 9 },
        "headerText": { "type": ["string", "null"], "maxLength": 20000 },
        "footerText": { "type": ["string", "null"], "maxLength": 20000 },
        "pageNumberFooterEnabled": { "type": "boolean" },
        "bodyPageNumberStart": { "type": "integer", "minimum": 1 }
        ,"paperSize": { "enum": ["A4", "A3", "LETTER"] }
        ,"orientation": { "enum": ["PORTRAIT", "LANDSCAPE"] }
        ,"topMarginPoints": { "type": "number", "minimum": 0, "maximum": 288 }
        ,"rightMarginPoints": { "type": "number", "minimum": 0, "maximum": 288 }
        ,"bottomMarginPoints": { "type": "number", "minimum": 0, "maximum": 288 }
        ,"leftMarginPoints": { "type": "number", "minimum": 0, "maximum": 288 }
      }
    },
    "cover": {
      "type": "object", "additionalProperties": false,
      "required": ["documentName", "projectName", "version"],
      "properties": {
        "documentName": { "$ref": "#/$defs/nonBlankText" },
        "projectName": { "$ref": "#/$defs/nonBlankText" },
        "version": { "$ref": "#/$defs/nonBlankText" }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "date", "description", "author"],
      "properties": {
        "version": { "$ref": "#/$defs/nonBlankText" },
        "date": { "$ref": "#/$defs/nonBlankText" },
        "description": { "$ref": "#/$defs/nonBlankText" },
        "author": { "$ref": "#/$defs/nonBlankText" }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "person", "date"],
      "properties": {
        "role": { "$ref": "#/$defs/nonBlankText" },
        "person": { "$ref": "#/$defs/nonBlankText" },
        "date": { "$ref": "#/$defs/nonBlankText" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "$ref": "#/$defs/nonBlankText" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/bulletListBlock" },
        { "$ref": "#/$defs/numberedListBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/diagramBlock" },
        { "$ref": "#/$defs/chartBlock" },
        { "$ref": "#/$defs/subsectionBlock" },
        { "$ref": "#/$defs/pageBreakBlock" }
      ]
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/$defs/nonBlankText" },
        "textRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/textRange" }
        },
        "styleName": { "$ref": "#/$defs/styleName" },
        "fontColor": { "$ref": "#/$defs/fontColor" }
      },
      "oneOf": [
        { "required": ["text"], "not": { "required": ["textRanges"] } },
        { "required": ["textRanges"], "not": { "required": ["text"] } }
      ]
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/nonBlankText" },
        "style": { "$ref": "#/$defs/textRangeStyle" }
      }
    },
    "textRangeStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": ".*\\S.*"
        },
        "asciiFontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": ".*\\S.*"
        },
        "farEastFontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": ".*\\S.*"
        },
        "fontSize": { "type": "number", "minimum": 1, "maximum": 200 },
        "fontColor": { "$ref": "#/$defs/fontColor" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" }
      }
    },
    "bulletListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "bulletList" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "styleName": { "$ref": "#/$defs/styleName" },
        "fontColor": { "$ref": "#/$defs/fontColor" }
      }
    },
    "numberedListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "numberedList" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "styleName": { "$ref": "#/$defs/styleName" },
        "fontColor": { "$ref": "#/$defs/fontColor" }
      }
    },
    "tableMerge": {
      "type": "object",
      "description": "Merge coordinates include the header at row 0. Follower cells may be blank or repeat the top-left value; different content is rejected.",
      "additionalProperties": false,
      "required": ["startRow", "startColumn", "rowSpan", "columnSpan"],
      "properties": {
        "startRow": { "type": "integer", "minimum": 0 },
        "startColumn": { "type": "integer", "minimum": 0 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "headers"],
      "properties": {
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "maxLength": 20000 }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "array",
            "items": { "type": "string", "maxLength": 20000 }
          }
        },
        "columnWidths": {
          "type": "array",
          "description": "Relative column-width weights. The table always fills the current page body width.",
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "styleName": { "enum": ["TableNormal", "TableHeader", "TableCell"] },
        "fontColor": { "$ref": "#/$defs/fontColor" },
        "headerTextStyle": { "$ref": "#/$defs/textRangeStyle" },
        "bodyTextStyle": { "$ref": "#/$defs/textRangeStyle" },
        "alignment": { "enum": ["LEFT", "CENTER", "RIGHT"] },
        "merges": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableMerge" }
        },
        "caption": { "type": "string", "maxLength": 20000 },
        "captionAutoNumbered": { "type": "boolean" },
        "captionPosition": { "$ref": "#/$defs/captionPosition" }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "image" },
        "source": { "$ref": "#/$defs/nonBlankText" },
        "assetId": { "type": "string", "format": "uuid" },
        "alternativeText": { "type": "string", "maxLength": 20000 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "caption": { "type": "string", "maxLength": 20000 },
        "captionPosition": { "$ref": "#/$defs/captionPosition" }
      },
      "dependentRequired": {
        "width": ["height"],
        "height": ["width"]
      },
      "oneOf": [
        { "required": ["source"], "not": { "required": ["assetId"] } },
        { "required": ["assetId"], "not": { "required": ["source"] } }
      ]
    },
    "diagramBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "diagram" },
        "diagramArtifactId": { "$ref": "#/$defs/nonBlankText" },
        "definition": { "$ref": "https://omni-office.local/schemas/diagram-spec/1.0/schema.json" },
        "embedMode": { "enum": ["PREVIEW_IMAGE", "EDITABLE_VISIO"] },
        "caption": { "type": "string", "maxLength": 20000 },
        "captionPosition": { "$ref": "#/$defs/captionPosition" },
        "maxWidthPoints": { "type": "number", "exclusiveMinimum": 0 },
        "maxHeightPoints": { "type": "number", "exclusiveMinimum": 0 }
      },
      "dependentRequired": {
        "maxWidthPoints": ["maxHeightPoints"],
        "maxHeightPoints": ["maxWidthPoints"]
      },
      "oneOf": [
        { "required": ["diagramArtifactId"], "not": { "required": ["definition"] } },
        { "required": ["definition"], "not": { "required": ["diagramArtifactId"] } }
      ]
    },
    "chartSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 20000 },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "number" }
        }
      }
    },
    "chartBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chartType", "categories", "series"],
      "properties": {
        "type": { "const": "chart" },
        "chartType": { "enum": ["COLUMN", "BAR", "PIE", "LINE", "RADAR"] },
        "title": { "type": "string", "maxLength": 20000 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/nonBlankText" }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/chartSeries" }
        },
        "widthPoints": { "type": "number", "minimum": 100, "maximum": 1000 },
        "heightPoints": { "type": "number", "minimum": 100, "maximum": 1000 },
        "legendVisible": { "type": "boolean" },
        "legendPosition": { "enum": ["BOTTOM", "TOP", "LEFT", "RIGHT"] },
        "showValues": { "type": "boolean" },
        "showPercentages": { "type": "boolean" },
        "categoryAxisTitle": { "type": ["string", "null"], "maxLength": 20000 },
        "valueAxisTitle": { "type": ["string", "null"], "maxLength": 20000 },
        "caption": { "type": "string", "maxLength": 20000 },
        "captionAutoNumbered": { "type": "boolean" },
        "captionPosition": { "$ref": "#/$defs/captionPosition" }
      }
    },
    "subsectionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "blocks"],
      "properties": {
        "type": { "const": "subsection" },
        "title": { "$ref": "#/$defs/nonBlankText" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "pageBreakBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "pageBreak" }
      }
    }
  }
}
